# Use tty and IBM character set
# OPTIONS=windowtype:tty,symset:IBMGraphics_2,roguesymset:RogueEpyx

# Use curses and permament inventory
OPTIONS=windowtype:curses,symset:curses,perm_inv,perminv_mode:full

# Custom symbols (curses)
SYMBOLS=s_boulder:`
SYMBOLS=s_sink:#
SYMBOLS=s_fountain:\xfb

# Personal preferences
OPTIONS=name:Lisa,role:Valkyrie,race:Human,gender:female,align:neutral

# Pet names
OPTIONS=catname:Garfield,dogname:Idefix,horsename:Epona

# General options
OPTIONS=disclose:yi ya nv ng yc yo
OPTIONS=hilite_pet,lit_corridor
OPTIONS=noshowexp,time
OPTIONS=number_pad:-1
OPTIONS=suppress_alert:3.3.1,!tutorial

# Autopickup settings
OPTIONS=autopickup,pickup_types:$")?!=/(*

## always pick these:
AUTOPICKUP_EXCEPTION="<lichen corpse" 
AUTOPICKUP_EXCEPTION="<lizard corpse" 
## don't pick these:
AUTOPICKUP_EXCEPTION="> stone[^<]*$"
AUTOPICKUP_EXCEPTION="> gray stone[^<]*$"
AUTOPICKUP_EXCEPTION="> loadstone[^<]*$"
AUTOPICKUP_EXCEPTION="> rock[^<]*$"
AUTOPICKUP_EXCEPTION="> flint[^<]*$"
AUTOPICKUP_EXCEPTION="> glass[^<]*$"
AUTOPICKUP_EXCEPTION="> chest"
AUTOPICKUP_EXCEPTION="> ice box"
AUTOPICKUP_EXCEPTION="> large box"

#  Toggle menucolor use on or off
OPTIONS=menucolors
MENUCOLOR=" blessed " = green
MENUCOLOR=" holy " = green
MENUCOLOR=" cursed " = red
MENUCOLOR=" unholy " = red
MENUCOLOR=" cursed .* (being worn)" = orange&underline
MENUCOLOR=" gold piece" = yellow

# Status hilites
# Ensure changes will be shown for a few turns after they happen.
# You may need this first to enable Status hilites. Setting to 0 disables it entirely.
OPTIONS=statushilites:10

# Always show gold as the proper color.
OPTIONS=hilite_status:gold/always/yellow

# Show when XL changes.
OPTIONS=hilite_status:experience-level/changed/white/cyan

# Highlight multiple encumbrance statuses.
OPTIONS=hilite_status:carrying-capacity/burdened/yellow/stressed/orange

# Highlight when hungry or satiated. See the relevant section of the article for 'hunger'.
OPTIONS=hilite_status:hunger/satiated/yellow/hungry/orange/weak/red/fainting/red

# When hallucinating or confused. Can be done for stun too.
OPTIONS=hilite_status:condition/hallu/yellow/conf/orange/stun/magenta

# When blind or levitating. See the article on the remaining 'conditions'.
OPTIONS=hilite_status:condition/blind/yellow/lev/cyan

# Specify multiple cutoffs for all ability scores.
OPTIONS=hilite_status:characteristics/<5/red/>6/orange/>8/brown/>11/yellow/>13/green/>16/cyan/>18/lightblue

# Specify percentage cutoffs for hitpoints.
OPTIONS=hilite_status:hitpoints/100%/brightgreen/<100%/green/<60%/yellow/<30%/red

# the above line is equivalent to:
OPTIONS=hilite_status:alignment/lawful/lightgreen
